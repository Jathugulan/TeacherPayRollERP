{
  "info": {
    "name": "ERP Teacher Attendance & Salary Management API",
    "_postman_id": "erp-teacher-attendance-salary-2026",
    "description": "Complete REST API collection for ERP Teacher Attendance & Salary Management System with RBAC (Admin, HR, Accountant, Teacher).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "teacherToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "teacherId",
      "value": "",
      "type": "string"
    },
    {
      "key": "leaveId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@erp.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Teacher)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('teacherToken', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@erp.com\",\n  \"password\": \"Teacher@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"mock-google-token-jathu@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/google", "host": ["{{baseUrl}}"], "path": ["auth", "google"] }
          }
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Teachers",
      "item": [
        {
          "name": "Create Teacher",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('teacherId', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"EMP009\",\n  \"fullName\": \"Robert Oppenheimer\",\n  \"email\": \"robert.opp@erp.com\",\n  \"phone\": \"0771234567\",\n  \"address\": \"Colombo\",\n  \"joiningDate\": \"2026-08-01\",\n  \"department\": \"Physics\",\n  \"designation\": \"Professor\",\n  \"salaryPerDay\": 500\n}"
            },
            "url": { "raw": "{{baseUrl}}/teachers", "host": ["{{baseUrl}}"], "path": ["teachers"] }
          }
        },
        {
          "name": "Get All Teachers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/teachers?page=1&limit=10&status=ACTIVE",
              "host": ["{{baseUrl}}"],
              "path": ["teachers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "ACTIVE" }
              ]
            }
          }
        },
        {
          "name": "Get Teacher By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/teachers/{{teacherId}}", "host": ["{{baseUrl}}"], "path": ["teachers", "{{teacherId}}"] }
          }
        },
        {
          "name": "Get Teacher Statistics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/teachers/{{teacherId}}/statistics", "host": ["{{baseUrl}}"], "path": ["teachers", "{{teacherId}}", "statistics"] }
          }
        },
        {
          "name": "Get Teacher Attendance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/teachers/{{teacherId}}/attendance?month=8&year=2026", "host": ["{{baseUrl}}"], "path": ["teachers", "{{teacherId}}", "attendance"] }
          }
        },
        {
          "name": "Get Teacher Salary History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/teachers/{{teacherId}}/salary", "host": ["{{baseUrl}}"], "path": ["teachers", "{{teacherId}}", "salary"] }
          }
        },
        {
          "name": "Update Teacher",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"designation\": \"Senior Professor\",\n  \"salaryPerDay\": 550\n}"
            },
            "url": { "raw": "{{baseUrl}}/teachers/{{teacherId}}", "host": ["{{baseUrl}}"], "path": ["teachers", "{{teacherId}}"] }
          }
        },
        {
          "name": "Deactivate Teacher (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/teachers/{{teacherId}}", "host": ["{{baseUrl}}"], "path": ["teachers", "{{teacherId}}"] }
          }
        }
      ]
    },
    {
      "name": "3. Attendance",
      "item": [
        {
          "name": "Mark Attendance",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"date\": \"2026-08-21\",\n  \"status\": \"PRESENT\",\n  \"remarks\": \"Lecture conducted on time\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/attendance", "host": ["{{baseUrl}}"], "path": ["attendance"] }
          }
        },
        {
          "name": "Bulk Mark Attendance",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-08-21\",\n  \"records\": [\n    { \"teacherId\": \"{{teacherId}}\", \"status\": \"PRESENT\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/attendance/bulk", "host": ["{{baseUrl}}"], "path": ["attendance", "bulk"] }
          }
        },
        {
          "name": "Today's Attendance Breakdown",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/attendance/today", "host": ["{{baseUrl}}"], "path": ["attendance", "today"] }
          }
        },
        {
          "name": "Monthly Attendance Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/attendance/summary?month=8&year=2026", "host": ["{{baseUrl}}"], "path": ["attendance", "summary"] }
          }
        },
        {
          "name": "Query Attendance History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/attendance?month=8&year=2026", "host": ["{{baseUrl}}"], "path": ["attendance"] }
          }
        }
      ]
    },
    {
      "name": "4. Leaves",
      "item": [
        {
          "name": "Apply Leave",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('leaveId', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"2026-08-27\",\n  \"endDate\": \"2026-08-29\",\n  \"reason\": \"Attending education conference\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/leaves", "host": ["{{baseUrl}}"], "path": ["leaves"] }
          }
        },
        {
          "name": "Get All Leaves",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/leaves?status=PENDING", "host": ["{{baseUrl}}"], "path": ["leaves"] }
          }
        },
        {
          "name": "Leave Summary Quota",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/leaves/summary/{{teacherId}}", "host": ["{{baseUrl}}"], "path": ["leaves", "summary", "{{teacherId}}"] }
          }
        },
        {
          "name": "Approve Leave",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"adminRemarks\": \"Approved by HOD\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/leaves/{{leaveId}}/approve", "host": ["{{baseUrl}}"], "path": ["leaves", "{{leaveId}}", "approve"] }
          }
        },
        {
          "name": "Reject Leave",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"adminRemarks\": \"Insufficient staffing on requested dates\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/leaves/{{leaveId}}/reject", "host": ["{{baseUrl}}"], "path": ["leaves", "{{leaveId}}", "reject"] }
          }
        }
      ]
    },
    {
      "name": "5. Salary & Payroll",
      "item": [
        {
          "name": "Calculate Salary Preview",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/salary/calculate/{{teacherId}}?month=8&year=2026", "host": ["{{baseUrl}}"], "path": ["salary", "calculate", "{{teacherId}}"] }
          }
        },
        {
          "name": "Generate Single Teacher Salary",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"month\": 8,\n  \"year\": 2026\n}"
            },
            "url": { "raw": "{{baseUrl}}/salary/generate", "host": ["{{baseUrl}}"], "path": ["salary", "generate"] }
          }
        },
        {
          "name": "Generate Salaries for All Teachers",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"month\": 8,\n  \"year\": 2026\n}"
            },
            "url": { "raw": "{{baseUrl}}/salary/generate-all", "host": ["{{baseUrl}}"], "path": ["salary", "generate-all"] }
          }
        },
        {
          "name": "Get Salary Reports & History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/salary?month=8&year=2026", "host": ["{{baseUrl}}"], "path": ["salary"] }
          }
        },
        {
          "name": "Get Salary Summary Metrics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/salary/summary?month=8&year=2026", "host": ["{{baseUrl}}"], "path": ["salary", "summary"] }
          }
        }
      ]
    },
    {
      "name": "6. Dashboard & Search",
      "item": [
        {
          "name": "Dashboard Overview",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/overview", "host": ["{{baseUrl}}"], "path": ["dashboard", "overview"] }
          }
        },
        {
          "name": "Dashboard Detailed Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/stats", "host": ["{{baseUrl}}"], "path": ["dashboard", "stats"] }
          }
        },
        {
          "name": "Global Search",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/search?q=john", "host": ["{{baseUrl}}"], "path": ["search"] }
          }
        }
      ]
    }
  ]
}
